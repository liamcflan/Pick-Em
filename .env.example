# Copy to .env.local for local development. Never commit .env.local.

# --- Next.js app (public: shipped to the browser) -------------------------------------------
# From Supabase dashboard → Project Settings → API (or `supabase start` output for local).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-anon-or-publishable-key
# Public URL of the deployed app; used to build OAuth / email redirect links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Shared secret between pg_cron / admin and the job endpoints ------------------------------
# Generate with: openssl rand -hex 32
JOB_SECRET=replace-with-64-hex-chars

# --- Python jobs only (never read by Next.js) -----------------------------------------------
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
APP_URL=http://localhost:3000

# --- Optional: picks-due reminder emails (Python jobs only) ---------------------------------
# Leave blank to disable. Resend: https://resend.com (free tier is plenty for a friend group).
RESEND_API_KEY=
REMINDER_FROM_EMAIL=Pick-Em <picks@your-domain.com>
