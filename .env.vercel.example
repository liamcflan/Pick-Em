# Production environment for Vercel. Copy to .env.vercel (gitignored), fill in, then import:
#   Vercel -> your project -> Settings -> Environment Variables -> "Import .env" (upload or paste)
# Tick Production (and Preview if dev deployments should use the same Supabase project), then
# redeploy; variables only apply to new builds.

# Supabase -> Project Settings -> Data API: "Project URL". It is also the ref in the dashboard
# address bar: https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Project Settings -> API Keys: the key labelled Publishable (sb_publishable_...). Older projects: "anon" under Legacy.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE

# Same page: the key labelled Secret (sb_secret_..., click Reveal). Older projects: "service_role".
# Bypasses row-level security; read only by the Python jobs.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE

# The production address, no trailing slash. Before the custom domain is live, use the
# *.vercel.app address from Vercel -> project overview -> Domains instead.
NEXT_PUBLIC_APP_URL=https://10kpoolhq.com
APP_URL=https://10kpoolhq.com

# Generate yourself: openssl rand -hex 32. The same value goes into supabase/cron/schedule.sql.
JOB_SECRET=REPLACE-WITH-64-HEX-CHARS

# Optional: picks-due reminder emails. Leave blank to disable.
# resend.com -> API Keys; sender must be on a domain verified under resend.com -> Domains,
# e.g. Pick-Em <no-reply@10kpoolhq.com> once 10kpoolhq.com is verified there.
RESEND_API_KEY=
REMINDER_FROM_EMAIL=
